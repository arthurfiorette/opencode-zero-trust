{
  "name": "opencode-zero-trust",
  "version": "0.2.1",
  "description": "Cloudflare Tunnel and Zero Trust access for the OpenCode V2 daemon",
  "keywords": [
    "opencode",
    "plugin",
    "cloudflare",
    "zero-trust"
  ],
  "homepage": "https://github.com/arthurfiorette/opencode-zero-trust#readme",
  "bugs": {
    "url": "https://github.com/arthurfiorette/opencode-zero-trust/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arthurfiorette/opencode-zero-trust.git"
  },
  "funding": "https://github.com/arthurfiorette/opencode-zero-trust?sponsor=1",
  "license": "MIT",
  "author": "Arthur Fiorette <me@arthur.place>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "check": "pnpm lint-ci && pnpm build && pnpm test-types && pnpm test && pnpm test:integration && pnpm test:tui && pnpm test:package",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint-ci": "biome ci .",
    "lint-fix": "biome check --write --unsafe .",
    "prepack": "pnpm build",
    "test": "pnpm build && tsx --test test/unit/*.test.ts",
    "test:integration": "pnpm build && tsx --test test/integration/*.test.ts",
    "test:package": "node scripts/check-package.mjs",
    "test:tui": "pnpm build && bun --conditions=browser test ./test/tui",
    "test-types": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/client": "2.0.29",
    "@opencode/plugin": "2.0.29",
    "http-proxy": "^1.18.1",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@arthurfiorette/biomejs-config": "^2.0.1",
    "@biomejs/biome": "^2.5.14",
    "@opencode/sdk": "2.0.29",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^24.13.6",
    "solid-js": "1.9.12",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@opentui/core": "^0.5.17",
    "@opentui/solid": "^0.5.17",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.16"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error",
      "version": ">=24.16"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
